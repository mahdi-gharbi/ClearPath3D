Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: map
      Cell Size: 1
      Plane Cell Count: 10
      Offset: {X: 3, Y: 2, Z: 0}
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Marker Scale: 0.5
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /clearpath3d/map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      Color Scheme: map
      Alpha: 0.7
    - Class: rviz_default_plugins/PointCloud2
      Name: Points
      Enabled: true
      Topic:
        Value: /clearpath3d/points
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 5
      Color Transformer: RGB8
      Style: Points
      Size (Pixels): 2
    - Class: rviz_default_plugins/MarkerArray
      Name: Tracks
      Enabled: true
      Topic:
        Value: /clearpath3d/tracks
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 5
    - Class: rviz_default_plugins/Path
      Name: Path
      Enabled: true
      Topic:
        Value: /clearpath3d/path
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      Color: 224; 49; 49
      Line Width: 0.05
      Line Style: Billboards
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 9
      Focal Point: {X: 3, Y: 2, Z: 0}
      Pitch: 0.9
      Yaw: 3.9
Window Geometry:
  Width: 1280
  Height: 800
